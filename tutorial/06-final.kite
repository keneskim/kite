# 把"打一下"抽成函数，以后调数值只改这里
fn hit(power, guard)
    ret power - guard

hero = 30
slime = 28
turn = 1

rp ut hero <= 0 || slime <= 0
    if turn % 2 == 1
        slime = slime - hit(9, 2)
        p "第 {turn} 回合：勇者攻击，史莱姆剩 {slime}"
    else
        hero = hero - hit(7, 2)
        p "第 {turn} 回合：史莱姆攻击，勇者剩 {hero}"
    turn = turn + 1

if slime <= 0
    p "勇者赢了！"
else
    p "勇者倒下了……"
